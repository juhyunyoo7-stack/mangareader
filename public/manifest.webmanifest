{
  "name": "MangaReader",
  "short_name": "MangaReader",
  "description": "Offline manga and comic reader. Files never leave your device.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f0f10",
  "theme_color": "#0f0f10",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "books",
          "accept": [".cbz", ".zip", ".cbr", ".cb7", ".pdf", ".epub", "application/zip", "application/vnd.comicbook+zip", "application/octet-stream", "image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.comicbook+zip": [".cbz"],
        "application/zip": [".zip"]
      }
    }
  ]
}
